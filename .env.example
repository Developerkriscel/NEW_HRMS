# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster.mongodb.net/nexahr)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@clusterayushhrms.gcc9uwz.mongodb.net/?appName=ClusterAyushHRMS&compressors=zlib
MONGODB_CONNECT_TIMEOUT_MS=4000
MONGODB_SOCKET_TIMEOUT_MS=15000

# JWT signing secret (use a long random string in production)
JWT_SECRET=NexaHRSuperSecretKey2025ForJWTTokenSigningMustBe256BitsOrMore

# Token expiry (ms)
JWT_ACCESS_TOKEN_EXPIRY=3600000
JWT_REFRESH_TOKEN_EXPIRY=604800000

# Public base URL used by the browser client (same-origin by default)
NEXT_PUBLIC_API_URL=/api

# Used to build absolute links (password reset, etc.)
FRONTEND_URL=http://localhost:3000

# Encrypts SMTP passwords saved from Settings > Email Settings.
# Use a long random value in production. If omitted, JWT_SECRET is used.
MAIL_SETTINGS_SECRET=replace-with-a-long-random-secret

# Private file storage. Keep STORAGE_DRIVER=local for development, or set it
# to r2 with Cloudflare R2 credentials in production.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=hrms-image
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Legacy SMTP fallback. Prefer Settings > Email Settings inside the app so
# admins can change sender details without editing deployment env vars.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM="NexaHR <your-email@example.com>"
